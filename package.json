{
  "name": "brightside-higgsfield-remote",
  "version": "0.7.2",
  "description": "Brightside film- og promptassistent med lokal Higgsfield-styring",
  "main": "src/main.js",
  "author": "Brightside Pictures ApS",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js && node --test test/*.test.js",
    "dist:mac": "electron-builder --mac --arm64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.8",
    "openai": "^5.19.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "pictures.brightside.higgsfieldremote",
    "productName": "Brightside Film Remote",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "identity": "-"
    },
    "dmg": {
      "title": "Brightside Film Remote",
      "backgroundColor": "#111111",
      "window": {
        "width": 560,
        "height": 470
      },
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 420,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 280,
          "y": 380,
          "type": "file",
          "path": "build/INSTALLATION.txt"
        }
      ]
    }
  }
}
